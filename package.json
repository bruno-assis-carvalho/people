    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.9.0",
    "prettier": "^3.1.1",
    "sass-embedded": "^1.105.1",
    "turbo": "^2.6.1",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.11.0",
