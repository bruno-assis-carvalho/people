# Auth0 Single Page Application credentials.
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id

# Set this to the collector URL provided by your Grafana Faro application.
VITE_FARO_URL=
VITE_FARO_APP_NAME=people-local
VITE_FARO_APP_VERSION=1.0.0
# Defaults to the current Vite mode when omitted.
VITE_FARO_APP_ENVIRONMENT=
