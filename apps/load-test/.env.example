API_URL=http://localhost:3000
WEB_URL=http://localhost:3000
TARGET_ENV=local
SEED_COUNT=5000
SEED_USERS=50
SEED_OUTPUT_MANIFEST=./data/e2e-manifest.json
AUTH_EMAIL=admin@example.com
