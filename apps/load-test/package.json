{
  "name": "@repo/load-test",
  "private": true,
  "scripts": {
    "generate:manifest": "npm run build --workspace=@people/mocks && node --env-file-if-exists=.env --import tsx src/generators/seed-manifest.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/run-gatling.ts seed",
    "seed:e2e": "npm run seed",
    "load:api": "node --env-file-if-exists=.env --import tsx src/run-gatling.ts api-load",
    "load:web": "node --env-file-if-exists=.env --import tsx src/run-gatling.ts web-smoke",
    "test": "node --import tsx --test src/auth/authentication.test.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@people/mocks": "*",
    "@gatling.io/core": "latest",
    "@gatling.io/http": "latest"
  },
  "devDependencies": {
    "@gatling.io/cli": "latest",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
