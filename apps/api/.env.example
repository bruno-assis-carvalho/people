PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/people

# Optional OpenTelemetry/Grafana Cloud configuration.
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable remote telemetry locally.
OTEL_SERVICE_NAME=express-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_RESOURCE_ATTRIBUTES=service.namespace=express-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# Example: Authorization=Basic%20<base64-instance-id-and-token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1


AUTH0_DOMAIN=https://dev-uf0c2erh6gefw46g.us.auth0.com
AUTH0_AUDIENCE=people-register
AUTH0_ROLES_CLAIM=roles