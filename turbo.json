{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "seed": {
      "cache": false,
      "env": [
        "API_URL",
        "TARGET_ENV",
        "SEED_OUTPUT_MANIFEST",
        "AUTH0_DOMAIN",
        "AUTH0_AUDIENCE",
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET"
      ]
    },
    "seed:e2e": {
      "cache": false,
      "env": [
        "API_URL",
        "TARGET_ENV",
        "SEED_OUTPUT_MANIFEST",
        "AUTH0_DOMAIN",
        "AUTH0_AUDIENCE",
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET"
      ]
    },
    "load:api": {
      "cache": false,
      "env": [
        "API_URL",
        "TARGET_ENV",
        "AUTH0_DOMAIN",
        "AUTH0_AUDIENCE",
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET"
      ]
    },
    "generate:manifest": {
      "cache": false,
      "env": ["TARGET_ENV", "SEED_OUTPUT_MANIFEST"]
    },
    "load:web": {
      "cache": false,
      "env": [
        "WEB_URL",
        "TARGET_ENV",
        "AUTH0_DOMAIN",
        "AUTH0_AUDIENCE",
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "persistent": true
    }
  }
}
